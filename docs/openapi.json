{
    "openapi": "3.1.0",
    "info": {
        "title": "Tasks API",
        "summary": "API REST para gestión de tareas.",
        "description": "Acopla todos los endpoints habilitados para la gestión de tareas.",
        "version": "0.1.0"
    },
    "paths": {
