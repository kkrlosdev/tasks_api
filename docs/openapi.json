                    }
                }
            },
            "put": {
                "tags": [
                    "Gestión de tareas."
                ],
                "summary": "Actualiza completamente un recurso en la base de datos",
                "description": "Validamos la estructura del JSON mediante un modelo TaskUpdate donde recibamos el ID y los datos de la tarea.",
